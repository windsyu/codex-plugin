[Unit]
Description=Codex relay single-workbench IP trial
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=codex-relay-trial
Group=codex-relay-trial
EnvironmentFile=/etc/codex-relay-trial.env
Environment=TOKIO_WORKER_THREADS=1
WorkingDirectory=/var/lib/codex-relay-trial
ExecStart=/opt/codex-relay-trial/bin/codex-relayd --data-dir /var/lib/codex-relay-trial --portal-origin ${RELAY_PORTAL_ORIGIN} --workbench-origin ${RELAY_WORKBENCH_ORIGIN} --fixed-gateway-id ${RELAY_GATEWAY_ID} --password-workers 1 --trusted-client-ip-header x-relay-client-ip serve --bind 127.0.0.1:8787
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codex-relay-trial
PrivateTmp=true
CPUAccounting=true
CPUQuota=35%
MemoryAccounting=true
# MemoryLimit is retained for the target's systemd 239 / cgroup v1.
MemoryLimit=384M
TasksAccounting=true
TasksMax=64

[Install]
WantedBy=multi-user.target
